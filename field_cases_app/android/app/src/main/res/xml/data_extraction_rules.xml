<?xml version="1.0" encoding="utf-8"?>
<!-- لا نسخ احتياطي سحابي ولا نقل تلقائي بين الأجهزة؛ النسخ الاحتياطي يدوي ومشفر من داخل التطبيق. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
